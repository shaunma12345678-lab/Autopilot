generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  stripeId          String?
  plan              Plan               @default(FREE)
  createdAt         DateTime           @default(now())
  businesses        Business[]
  connectedAccounts ConnectedAccount[]
  agentRuns         AgentRun[]
  conversations     Conversation[]
  customTools       CustomTool[]
  agencyName        String?
  agencyLogo        String?
  agencyColor       String             @default("#6366f1")
  agencyDomain      String?
  isAgency          Boolean            @default(false)
}

model ConnectedAccount {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  accountName  String?
  accountEmail String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scopes       String[]  @default([])
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model AgentRun {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentSlug  String
  agentName  String
  status     RunStatus   @default(RUNNING)
  input      Json        @default("{}")
  output     Json?
  errorMsg   String?
  durationMs Int?
  createdAt  DateTime    @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([agentSlug])
  @@index([createdAt])
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Business {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String
  description    String             @default("")
  location       String
  phone          String?
  website        String?
  brandVoice     Json               @default("{}")
  socialProfiles Json               @default("{}")
  activeAgents   String[]           @default([])
  createdAt      DateTime           @default(now())
  content        Content[]
  reviews        Review[]
  leads          Lead[]
  reports        Report[]
  sites          Site[]
  conversations  Conversation[]
  agentMemory    AgentMemory[]
  fewShotExamples FewShotExample[]
  scheduledRuns  ScheduledRun[]
  exchangeRequests ExchangeRequest[]

  @@index([userId])
}

model Site {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug       String    @unique
  title      String
  html       String
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([slug])
}

model Content {
  id          String      @id @default(cuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        ContentType
  platform    String
  body        String
  hashtags    String[]    @default([])
  status      Status      @default(PENDING)
  scheduledAt DateTime?
  postedAt    DateTime?
  createdAt   DateTime    @default(now())

  @@index([businessId])
  @@index([status])
}

model Review {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform     String
  rating       Int
  reviewText   String
  reviewerName String
  response     String?
  status       Status   @default(PENDING)
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([status])
}

model Lead {
  id                   String      @id @default(cuid())
  businessId           String
  business             Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  phone                String?
  source               String
  status               LeadStatus  @default(NEW)
  score                Int         @default(0)
  notes                String?
  distressLayer        Int         @default(1)
  earlyWarning         Boolean     @default(false)
  confidenceScore      Int?
  timeToDistressMonths Int?
  assetClass           String      @default("residential")
  propertyType         String?
  estimatedValue       Float?
  rawSignals           RawSignal[]
  createdAt            DateTime    @default(now())

  @@index([businessId])
  @@index([status])
  @@index([earlyWarning])
  @@index([distressLayer])
  @@index([assetClass])
}

model RawSignal {
  id         String   @id @default(cuid())
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  apn        String?
  address    String
  county     String
  signalType String
  signalDate DateTime
  rawData    Json
  source     String
  assetClass String   @default("residential")
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([apn])
  @@index([county, signalType])
  @@index([address])
  @@index([assetClass, signalType])
}

model Source {
  id          String    @id @default(cuid())
  name        String
  county      String
  layer       Int
  lastSuccess DateTime?
  lastError   String?
  status      String    @default("active")
  assetClass  String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([name, county])
  @@index([county])
  @@index([status])
}

model Report {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  data       Json
  summary    String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

enum Plan {
  FREE
  STARTER
  GROWTH
  PRO
  AGENCY_STARTER
  AGENCY_GROWTH
  AGENCY_PREMIUM
  ENTERPRISE
}

enum ContentType {
  SOCIAL_POST
  EMAIL
  SMS
  BLOG_POST
  AD_COPY
  PROMO
  REVIEW_RESPONSE
  WEBSITE
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  POSTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// ── Conversation & Message (multi-turn chat, #5 #7) ───────────────────────────

model Conversation {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  agentSlug  String
  agentName  String
  title      String    @default("New Chat")
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]

  @@index([userId, agentSlug])
  @@index([businessId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  metadata       Json         @default("{}")
  qualityScore   Int?
  iterations     Int?
  searchUsed     Boolean      @default(false)
  toolsUsed      String[]     @default([])
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ── Agent Memory (#5) ─────────────────────────────────────────────────────────

model AgentMemory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agentSlug  String
  key        String
  value      String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([businessId, agentSlug, key])
  @@index([businessId, agentSlug])
}

// ── Few-Shot Examples (#15) ───────────────────────────────────────────────────

model FewShotExample {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agentSlug  String
  userInput  String
  agentOutput String
  quality    Int      @default(8)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([businessId, agentSlug])
}

// ── Custom Tools (#10) ────────────────────────────────────────────────────────

model CustomTool {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  toolType    String   @default("webhook")
  config      Json     @default("{}")
  inputSchema Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ── Scheduled Runs with Diff Detection (#8) ───────────────────────────────────

model ScheduledRun {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agentSlug       String
  agentName       String
  enabled         Boolean   @default(true)
  cronExpression  String
  lastOutput      String?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastChangePct   Float?
  notifyOnChange  Boolean   @default(true)
  changeThreshold Float     @default(25.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, agentSlug])
  @@index([businessId])
}

// ═══════════════ Content Engine (CONTENT_ENGINE_SPEC.md) ═══════════════

model BrandProfile {
  id            String   @id @default(cuid())
  name          String
  niche         String
  audienceNotes String?
  voiceRules    String?
  platforms     String[]
  weights       Json?    // per-profile virality dimension weights (learned)
  exemplars     ContentExemplar[]
  ideas         ContentIdea[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContentExemplar {
  id             String       @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  platform       String
  sourceUrl      String?
  transcript     String?
  hook           String?
  isOwn          Boolean      @default(true)
  performance    Json?
  whyItWorked    String?
  createdAt      DateTime     @default(now())
}

model ContentIdea {
  id             String       @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  runId          String
  platform       String
  format         String
  title          String
  premise        String
  hooks          String[]
  angle          String
  whyItTravels   String
  viralityScore  Float
  scoreBreakdown Json
  confidence     Float
  status         String       @default("new")
  steering       Json?        // the brief's steering (goal/tone/formats/audience) — for learning what converts
  expansions     ContentExpansion[]
  outcome        ContentOutcome?
  createdAt      DateTime     @default(now())

  @@index([brandProfileId, status])
  @@index([runId])
}

model ContentExpansion {
  id        String      @id @default(cuid())
  ideaId    String
  idea      ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  version   Int         @default(1)
  createdAt DateTime    @default(now())
}

model TrendSignal {
  id           String    @id @default(cuid())
  platform     String
  kind         String
  label        String
  description  String?
  velocity     Float?
  saturation   Float?
  peakEstimate DateTime?
  sourceUrl    String?
  capturedAt   DateTime  @default(now())

  @@index([platform, capturedAt])
}

model ContentOutcome {
  id               String      @id @default(cuid())
  ideaId           String      @unique
  idea             ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  publishedAt      DateTime?
  postUrl          String?
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  followsGained    Int?
  watchThrough     Float?
  actualPercentile Float?
  hookUsed         String?     // which hook variant was actually posted (hook tournament)
  couponCode       String?     // the code tied to this post (conversion tracking)
  redemptions      Int?        // real business walked through the door from this post
  revenue          Float?      // real $ attributed to this post
  shaunNotes       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ScoreCalibration {
  id         String   @id @default(cuid())
  runId      String
  predicted  Float
  actual     Float
  dimension  String?
  recordedAt DateTime @default(now())
}

// ── Finance Operator (own bank-data engine — no Plaid) ──────────────────────

model FinanceAccount {
  id          String    @id
  businessId  String
  name        String
  institution String?
  kind        String    @default("checking")   // checking | savings | card | stripe
  currency    String    @default("USD")
  balance     Float?
  balanceAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FinanceTxn {
  id            String   @id
  accountId     String
  businessId    String
  date          DateTime @db.Date
  amount        Float                       // + income, − expense
  name          String                      // raw statement descriptor
  merchant      String                      // normalized merchant
  category      String   @default("other")
  catConfidence Float    @default(0)
  catSource     String   @default("none")   // user | rule | builtin | keyword | ai
  recurring     Boolean  @default(false)
  transfer      Boolean  @default(false)
  source        String   @default("csv")    // csv | ofx | qif | stripe
  hash          String   @unique            // stable dedupe signature
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([businessId, date(sort: Desc)])
  @@index([merchant])
}

model FinanceRule {
  id         String   @id
  businessId String
  merchant   String
  category   String
  createdAt  DateTime @default(now())

  @@unique([businessId, merchant])
}

// ── Stocks vertical (SEC EDGAR fundamentals + proprietary quality scoring) ──
model Ticker {
  id                       String        @id @default(cuid())
  cik                      String        @unique
  symbol                   String        @unique
  name                     String
  sector                   String?
  exchange                 String?

  // Growth / profitability / returns
  revenueTtm               Float?
  revenueGrowthYoyPct      Float?
  grossMarginPct           Float?
  operatingMarginPct       Float?
  netMarginPct             Float?
  roePct                   Float?
  roicPct                  Float?

  // Balance sheet
  debtToEquity             Float?
  interestCoveragePct      Float?
  currentRatio             Float?

  // Cash flow quality
  freeCashFlowTtm          Float?
  fcfMarginPct             Float?
  accrualsRatioPct         Float?

  // Dividends
  dividendYieldPct         Float?
  payoutRatioEarningsPct   Float?
  payoutRatioFcfPct        Float?
  dividendGrowthStreakYears Int?

  // Valuation (needs price feed)
  priceUsd                 Float?
  peRatio                  Float?
  pfcfRatio                Float?
  evEbitda                 Float?
  pegRatio                 Float?

  // Insider activity
  insiderNetSharesTtm      Int?

  // Validated academic composites (see lib/stock-scores/)
  piotroskiScore           Int?          // 0-9, Piotroski (2000)
  piotroskiDetail          Json?
  altmanZScore             Float?        // Altman (1968) bankruptcy predictor
  altmanZone               String?       // safe | grey | distress
  beneishMScore            Float?        // Beneish (1999) earnings-manipulation detector
  beneishFlag              Boolean?      // true when M > -1.78

  // Price-derived (Stooq daily history)
  momentum12m1Pct          Float?        // 12-month return excluding most recent month
  pctFrom52WeekHigh        Float?
  volatility30dPct         Float?        // annualized
  maxDrawdown1yPct         Float?
  betaVsSpy                Float?

  // Dilution
  sharesOutstanding        Float?
  buybackYieldPct          Float?        // negative = dilution

  // Sector-relative context
  sicCode                  String?
  sectorRelativeScore      Int?          // 0-100 vs. same-sector peers in our own dataset
  sectorPeerCount          Int?

  // Forward-looking signals (see lib/forward-signals.ts)
  rpoUsd                       Float?    // contracted revenue not yet recognized
  rpoToRevenueYears            Float?
  rpoGrowthYoyPct              Float?
  rndIntensityPct              Float?
  capexIntensityPct            Float?
  capexGrowthYoyPct            Float?
  deferredRevenueGrowthYoyPct  Float?
  revenueAccelerationPct       Float?
  forwardScore                 Int?
  forwardReasons               Json?

  // What management actually says in the filing (see lib/edgar-narrative.ts)
  narrativeSummary         String?
  narrativeStrategy        Json?
  narrativeGrowthDrivers   Json?
  narrativeHeadwinds       Json?
  narrativeCapitalPlans    Json?
  narrativeOutlookTone     String?       // constructive | mixed | cautious | unclear
  narrativeSourceUrl       String?
  narrativeFilingDate      String?

  // Valuation axis (lib/valuation.ts) — cheapness versus the company's OWN
  // history. Kept separate from qualityScore because the backtest showed
  // quality does not rank forward returns and valuation does; collapsing them
  // would hide the only axis with measured signal.
  valuationScore           Int?
  earningsYieldPct         Float?
  fcfYieldPct              Float?
  valuationPercentile      Float?
  valueTier                String?
  valuationReasons         Json?

  // Year-over-year risk-factor diff (lib/risk-factor-diff.ts) — what the
  // company NEWLY admits to. Companies add risk factors when the exposure
  // becomes real enough that omitting it creates liability.
  newRiskCount             Int?
  materialNewRisks         Json?
  riskFactorSummary        String?

  // Conviction tiering — independent gates, not an average (lib/conviction.ts)
  convictionTier           String?   // elite | high | standard | below-bar
  convictionGates          Json?
  convictionSummary        String?

  // Narrative-vs-numbers cross-validation (lib/contradiction-check.ts)
  credibilityScore         Int?
  contradictions           Json?
  contradictionFlags       Json?

  // Falsification conditions (lib/falsification.ts) — "what would change my
  // mind", as checkable thresholds derived from the thesis itself, not a
  // sentence. Recomputed every scoring run; falsificationTriggered records
  // which conditions from the PRIOR run have since tripped against fresh
  // data, which is what makes the commitment checkable rather than decorative.
  falsificationConditions  Json?
  falsificationFragility   String?   // robust | moderate | fragile
  falsificationSummary     String?
  falsificationTriggered   Json?

  // Accounting quality — is reported profit backed by cash? (lib/accounting-quality.ts)
  cashConversionRatio      Float?
  avgCashConversion        Float?
  dsoDays                  Float?
  dsoTrendDays             Float?
  inventoryTurns           Float?
  inventoryTurnsTrend      Float?
  accountingQualityScore   Int?
  accountingFlags          Json?

  // Balance-sheet landmines (see lib/balance-sheet-risk.ts)
  debtDueNext12MoUsd       Float?
  debtWallToFcfYears       Float?
  sbcToRevenuePct          Float?
  goodwillToAssetsPct      Float?
  hadGoodwillImpairment    Boolean?
  effectiveTaxRatePct      Float?
  balanceSheetFlags        Json?

  // Capital allocation track record (see lib/capital-allocation.ts)
  capitalAllocationScore   Int?
  avgBuybackPricePercentile Float?
  capitalAllocationReasons Json?

  // Governance from DEF 14A (see lib/governance.ts)
  governanceScore          Int?
  payAlignment             String?
  dualClass                Boolean?
  governanceSummary        String?
  governanceFlags          Json?
  governanceSourceUrl      String?

  // Live corporate events from 8-K filings (see lib/live-events.ts)
  liveEvents               Json?
  liveEventFlags           Json?
  hasRestatement           Boolean?
  hasAuditorChange         Boolean?
  // Going-concern hits were computed and fed into scoring but never persisted,
  // so no screen could gate on the most serious solvency warning a company can
  // issue. Stored now.
  goingConcernHits         Int?

  // Event significance (lib/event-significance.ts) — an AI read of the
  // single freshest structurally-notable 8-K, judging scale from what's
  // actually disclosed rather than treating every filing under one item
  // code identically. Runs on the fast path specifically to catch new
  // filings quickly; lastSignificantEventAccession prevents re-spending an
  // AI call re-reading a filing already assessed.
  lastSignificantEventAccession String?
  eventSignificanceHeadline     String?
  eventSignificanceLevel        String?   // major | moderate | minor | unclear
  eventSignificanceReasoning    String?
  eventSignificanceDate         String?
  eventSignificanceSourceUrl    String?

  // Benford digit analysis (lib/benford.ts) — forensic, never accusatory.
  benfordMad               Float?
  benfordConformity        String?
  benfordSampleSize        Int?

  // Short interest (lib/short-interest.ts) — what informed money bets against.
  shortSharesCurrent       Float?
  shortChangePct           Float?
  shortDaysToCover         Float?
  shortTrend               String?
  shortSettlementDate      String?

  // Federal contract scale (lib/federal-revenue.ts) — the paying agency's own
  // record, one side of the ledger the company does not write.
  federalContractValueUsd  Float?
  federalContractChangePct Float?
  federalAwardCount        Int?

  // Adversarial pass (lib/bear-case.ts) — a second read whose only job is to
  // attack the investment. Kept separate from qualityReasons so the case
  // against is never blended into the case for.
  bearSummary              String?
  bearThesisRisks          Json?
  bearKillShot             String?
  bearConviction           String?
  bearWhatMustGoRight      Json?
  execChangeCount          Int?

  // Investment verdict (lib/investment-verdict.ts) — synthesizes every
  // signal above into one governing answer: is this well-run, and is it a
  // good lead right now. The headline of the asset detail page.
  verdictSummary            String?
  verdictManagementQuality  String?   // strong | adequate | concerning | unclear
  verdictLeadQuality        String?   // strong_lead | worth_watching | not_a_lead | avoid
  verdictKeyStrengths       Json?
  verdictKeyConcerns        Json?
  verdictConflicts          Json?
  verdictConfidenceCaveat   String?

  // Insider activity from Form 4 (see lib/form4-insider.ts)
  insiderBuyCount90d       Int?
  insiderSellCount90d      Int?
  insiderNetSharesBought90d Float?
  insiderClusterBuy        Boolean?
  insiderSummary           String?

  // Multi-year consistency (see lib/consistency.ts)
  consistencyScore         Int?
  consistencyDetail        Json?
  yearsOfData              Int?

  // Recent news scan (see lib/company-news.ts)
  newsSummary              String?
  newsTone                 String?
  newsHeadlines            Json?
  newsMaterialConcerns     Json?

  // Position context — where price sits vs its own history
  pricePercentile1y        Int?
  trendState               String?       // uptrend | downtrend | sideways | unknown
  ma50                     Float?
  ma200                    Float?
  situationSummary         String?

  // Composite scoring + quality gate
  qualityScore             Int?          // retained: the opportunity/fundamental-strength composite
  qualityReasons           Json?
  riskScore                Int?          // 0-100, higher = more risk (separate axis, mirrors Deal Card v2)
  riskFlags                Json?
  strengthTier             String?       // strong | mixed | weak  (descriptive summary of fundamentals)
  actionSignal             String?       // buy | hold | pass — two-axis matrix (see lib/action-signal.ts)
  actionRationale          String?
  dataCompletenessPct      Int?
  dataConfidence           String        @default("insufficient")   // insufficient | low | medium | high
  fieldSources             Json?         // per-field { source, fetchedAt, isEstimate } attribution
  earlyWarning             Boolean       @default(false)

  lastScoredAt             DateTime?
  signals                  TickerSignal[]
  updatedAt                DateTime      @updatedAt
  createdAt                DateTime      @default(now())

  @@index([dataConfidence])
  @@index([qualityScore])
  @@index([riskScore])
  @@index([lastScoredAt])
  @@index([sicCode])
}

model TickerSignal {
  id         String   @id @default(cuid())
  tickerId   String
  ticker     Ticker   @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  signalType String   // going_concern_8k | insider_selling_cluster | form4_sale | form4_buy
  signalDate DateTime
  rawData    Json
  source     String
  createdAt  DateTime @default(now())

  @@index([tickerId])
  @@index([signalType])
}

// ── Score history — the baseline that makes deterioration detectable ──
// Every scoring run appends a snapshot. Without history there is no way to
// distinguish "this has always been mediocre" from "this was strong and is
// now falling apart" — and that difference is the entire basis of a sell
// signal. It also powers the trajectory chart.
model ScoreSnapshot {
  id            String   @id @default(cuid())
  subjectType   String   // stock | crypto
  subjectId     String
  symbol        String
  qualityScore  Int?
  riskScore     Int?
  forwardScore  Int?
  actionSignal  String?
  priceUsd      Float?
  top10HolderPct Float?
  capturedAt    DateTime @default(now())

  @@index([subjectType, symbol, capturedAt])
  @@index([subjectId])
}

// ── Discovery: companies surfaced by event, not by hand ──
// Mirrors the residential RawSignal -> Lead pipeline: discovery writes cheap
// event rows, a second pass analyzes the high-priority ones.
model DiscoveryEvent {
  id            String   @id @default(cuid())
  cik           String
  symbol        String?
  companyName   String
  eventType     String   // late_filing | ipo_pipeline | insider_cluster_buy | material_agreement
  eventDate     DateTime
  formType      String
  accessionNumber String?
  sourceUrl     String?
  priority      Int      @default(50)   // 0-100, drives which get analyzed first
  // Priority after time decay (lib/lead-decay.ts). Stored rather than computed
  // on read so the database can order and paginate on it; refreshed on every
  // discovery run, which is far more often than the ordering meaningfully moves.
  decayedPriority Float?
  decayRefreshedAt DateTime?
  rationale     String?
  processed     Boolean  @default(false)
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@unique([cik, eventType, eventDate])
  @@index([processed, priority])
  @@index([processed, decayedPriority])
  @@index([eventType])
  @@index([eventDate])
}

// ── Crypto vertical (market data + proprietary quality scoring) ──
model CryptoAsset {
  id                     String        @id @default(cuid())
  coingeckoId            String        @unique
  symbol                 String
  name                   String

  marketCapRank          Int?
  priceUsd               Float?
  volume24hUsd           Float?
  marketCapUsd           Float?
  priceChange24hPct      Float?
  priceChange7dPct       Float?
  circulatingSupplyPct   Float?

  // "Dividend equivalent" + tokenomics
  protocolRevenue30dUsd  Float?
  stakingYieldPct        Float?
  nextUnlockDate         DateTime?
  nextUnlockPctSupply    Float?

  // Dilution overhang
  fdvUsd                 Float?
  fdvToMcapRatio         Float?

  // Dev / network activity
  devActivityScore       Int?

  // Contract identity (needed for on-chain security checks)
  contractAddress        String?
  chainId                String?
  chainSlug              String?

  // Token security / rug risk (GoPlus) — binary risk, highest-value crypto criteria
  isHoneypot             Boolean?
  isMintable             Boolean?
  ownershipRenounced     Boolean?
  lpLocked               Boolean?
  isProxy                Boolean?
  buyTaxPct              Float?
  sellTaxPct             Float?
  holderCount            Int?
  topHolderPct           Float?        // largest single non-LP holder, % of supply
  top10HolderPct         Float?
  creatorPct             Float?
  securityScore          Int?          // 0-100, higher = safer
  securityFlags          Json?

  // Our own exchange-native market data (lib/exchange-aggregator.ts).
  // Sourced directly from regulated venues rather than an aggregator, so the
  // volume figure excludes wash-traded exchanges and the divergence field
  // exists at all — an aggregator hands you one blended number.
  consensusPriceUsd      Float?
  venueCount             Int?
  venueDivergencePct     Float?
  bidAskSpreadPct        Float?
  regulatedVolume24hUsd  Float?
  liquidityGrade         String?   // deep | adequate | thin | fragmented
  listingQualityScore    Int?
  exchangeNotes          Json?

  // Market microstructure (volume is wash-tradeable; depth is much harder to fake)
  orderbookDepth2PctUsd  Float?

  // Self-computed from price history
  volatility30dPct       Float?
  maxDrawdown1yPct       Float?
  btcCorrelation         Float?
  // Where price sits in its own 1-year range, 0=low, 100=high — crypto's
  // price-based stand-in for the stock side's own-history valuation
  // percentile (see lib/price-history.ts computePricePercentile). Used to
  // rank the crypto opportunity screen (lib/crypto-opportunity-screen.ts).
  pricePercentile1y      Int?

  // On-chain activity (lib/onchain.ts) — the crypto equivalent of reading the
  // filings. Only populated for base-layer chains it can read directly.
  onchainTransactions24h Int?
  onchainMarketCapPerTx  Float?
  onchainPercentile      Float?   // vs. same-purpose chains only, 0-100

  // Conviction tiering (lib/conviction.ts)
  convictionTier         String?
  convictionGates        Json?
  convictionSummary      String?

  // Composite scoring + quality gate
  qualityScore           Int?
  qualityReasons         Json?
  riskScore              Int?          // 0-100, higher = more risk (separate axis)
  riskFlags              Json?
  strengthTier           String?       // strong | mixed | weak (descriptive summary of fundamentals)
  actionSignal           String?       // buy | hold | pass — two-axis matrix (see lib/action-signal.ts)
  actionRationale        String?
  dataCompletenessPct    Int?
  dataConfidence         String        @default("insufficient")   // insufficient | low | medium | high
  fieldSources           Json?

  lastScoredAt           DateTime?
  signals                CryptoSignal[]
  updatedAt              DateTime      @updatedAt
  createdAt               DateTime     @default(now())

  @@index([dataConfidence])
  @@index([qualityScore])
  @@index([riskScore])
  @@index([lastScoredAt])
}

model CryptoSignal {
  id         String      @id @default(cuid())
  assetId    String
  asset      CryptoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  signalType String      // unlock_upcoming | liquidity_thin | dev_activity_drop
  signalDate DateTime
  rawData    Json
  source     String
  createdAt  DateTime    @default(now())

  @@index([assetId])
  @@index([signalType])
}

// ── 1031 exchange matching ──
model ExchangeRequest {
  id                      String    @id @default(cuid())
  businessId              String
  business                Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sellingPropertyAddress  String
  saleClosingDate         DateTime
  identificationDeadline  DateTime  // saleClosingDate + 45 days, IRS 1031 rule
  closingDeadline         DateTime  // saleClosingDate + 180 days, IRS 1031 rule
  targetPriceMin          Float?
  targetPriceMax          Float?
  targetPropertyType      String    @default("any") // residential | commercial | any
  targetCounties          String[]  @default([])
  status                  String    @default("active") // active | matched | closed | expired
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([businessId])
  @@index([status])
}

// ── Portfolio owner graph (entity resolution across distressed properties) ──
model Entity {
  id             String         @id @default(cuid())
  canonicalName  String
  entityType     String?        // llc | lp | corp | trust | individual
  state          String?
  propertyCount  Int            @default(0)
  updatedAt      DateTime       @updatedAt
  createdAt      DateTime       @default(now())
  aliases        EntityAlias[]
  properties     EntityProperty[]

  @@index([canonicalName])
}

model EntityAlias {
  id         String   @id @default(cuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  alias      String
  source     String
  confidence Float    @default(0.5)
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([alias])
}

model EntityProperty {
  id         String   @id @default(cuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  leadId     String   // soft reference to Lead.id, no formal relation (Lead is business-scoped/duplicated per-tenant; the entity graph is cross-tenant market intelligence)
  address    String
  assetClass String   @default("residential")
  confidence Float    @default(0.5)
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([leadId])
}

// ── AI Underwriter track record (predicted vs actual outcome) ──
model UnderwriteCall {
  id               String    @id @default(cuid())
  subjectType      String    // cre_lead | residential_lead | stock | crypto
  subjectId        String    // soft reference — Lead.id / Ticker.id / CryptoAsset.id depending on subjectType
  subjectLabel     String    // human-readable snapshot (address or symbol+name) at prediction time
  verdict          String    // buy | pass | hold
  predictedScore   Int
  rationale        Json
  confidenceAtCall Int
  predictedAt      DateTime  @default(now())
  reviewAt         DateTime  // when we should check the outcome
  actualOutcome    String?   // closed_won | closed_lost | still_open | price_up | price_down | user_reported
  actualOutcomeAt  DateTime?
  correct          Boolean?
  createdAt        DateTime  @default(now())

  @@index([subjectType, subjectId])
  @@index([reviewAt])
  @@index([correct])
}
