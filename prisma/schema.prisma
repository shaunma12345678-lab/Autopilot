generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  stripeId          String?
  plan              Plan               @default(FREE)
  createdAt         DateTime           @default(now())
  businesses        Business[]
  connectedAccounts ConnectedAccount[]
  agentRuns         AgentRun[]
  conversations     Conversation[]
  customTools       CustomTool[]
  agencyName        String?
  agencyLogo        String?
  agencyColor       String             @default("#6366f1")
  agencyDomain      String?
  isAgency          Boolean            @default(false)
}

model ConnectedAccount {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  accountName  String?
  accountEmail String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scopes       String[]  @default([])
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model AgentRun {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentSlug  String
  agentName  String
  status     RunStatus   @default(RUNNING)
  input      Json        @default("{}")
  output     Json?
  errorMsg   String?
  durationMs Int?
  createdAt  DateTime    @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([agentSlug])
  @@index([createdAt])
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Business {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String
  description    String             @default("")
  location       String
  phone          String?
  website        String?
  brandVoice     Json               @default("{}")
  socialProfiles Json               @default("{}")
  activeAgents   String[]           @default([])
  createdAt      DateTime           @default(now())
  content        Content[]
  reviews        Review[]
  leads          Lead[]
  reports        Report[]
  sites          Site[]
  conversations  Conversation[]
  agentMemory    AgentMemory[]
  fewShotExamples FewShotExample[]
  scheduledRuns  ScheduledRun[]

  @@index([userId])
}

model Site {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug       String    @unique
  title      String
  html       String
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([slug])
}

model Content {
  id          String      @id @default(cuid())
  businessId  String
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        ContentType
  platform    String
  body        String
  hashtags    String[]    @default([])
  status      Status      @default(PENDING)
  scheduledAt DateTime?
  postedAt    DateTime?
  createdAt   DateTime    @default(now())

  @@index([businessId])
  @@index([status])
}

model Review {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  platform     String
  rating       Int
  reviewText   String
  reviewerName String
  response     String?
  status       Status   @default(PENDING)
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([status])
}

model Lead {
  id                   String      @id @default(cuid())
  businessId           String
  business             Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  phone                String?
  source               String
  status               LeadStatus  @default(NEW)
  score                Int         @default(0)
  notes                String?
  distressLayer        Int         @default(1)
  earlyWarning         Boolean     @default(false)
  confidenceScore      Int?
  timeToDistressMonths Int?
  rawSignals           RawSignal[]
  createdAt            DateTime    @default(now())

  @@index([businessId])
  @@index([status])
  @@index([earlyWarning])
  @@index([distressLayer])
}

model RawSignal {
  id         String   @id @default(cuid())
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  apn        String?
  address    String
  county     String
  signalType String
  signalDate DateTime
  rawData    Json
  source     String
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([apn])
  @@index([county, signalType])
  @@index([address])
}

model Source {
  id          String    @id @default(cuid())
  name        String
  county      String
  layer       Int
  lastSuccess DateTime?
  lastError   String?
  status      String    @default("active")
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([name, county])
  @@index([county])
  @@index([status])
}

model Report {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String
  data       Json
  summary    String
  createdAt  DateTime @default(now())

  @@index([businessId])
}

enum Plan {
  FREE
  STARTER
  GROWTH
  PRO
  AGENCY_STARTER
  AGENCY_GROWTH
  AGENCY_PREMIUM
  ENTERPRISE
}

enum ContentType {
  SOCIAL_POST
  EMAIL
  SMS
  BLOG_POST
  AD_COPY
  PROMO
  REVIEW_RESPONSE
  WEBSITE
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  POSTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// ── Conversation & Message (multi-turn chat, #5 #7) ───────────────────────────

model Conversation {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  agentSlug  String
  agentName  String
  title      String    @default("New Chat")
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]

  @@index([userId, agentSlug])
  @@index([businessId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  metadata       Json         @default("{}")
  qualityScore   Int?
  iterations     Int?
  searchUsed     Boolean      @default(false)
  toolsUsed      String[]     @default([])
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ── Agent Memory (#5) ─────────────────────────────────────────────────────────

model AgentMemory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agentSlug  String
  key        String
  value      String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([businessId, agentSlug, key])
  @@index([businessId, agentSlug])
}

// ── Few-Shot Examples (#15) ───────────────────────────────────────────────────

model FewShotExample {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agentSlug  String
  userInput  String
  agentOutput String
  quality    Int      @default(8)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([businessId, agentSlug])
}

// ── Custom Tools (#10) ────────────────────────────────────────────────────────

model CustomTool {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  toolType    String   @default("webhook")
  config      Json     @default("{}")
  inputSchema Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ── Scheduled Runs with Diff Detection (#8) ───────────────────────────────────

model ScheduledRun {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agentSlug       String
  agentName       String
  enabled         Boolean   @default(true)
  cronExpression  String
  lastOutput      String?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastChangePct   Float?
  notifyOnChange  Boolean   @default(true)
  changeThreshold Float     @default(25.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([businessId, agentSlug])
  @@index([businessId])
}

// ═══════════════ Content Engine (CONTENT_ENGINE_SPEC.md) ═══════════════

model BrandProfile {
  id            String   @id @default(cuid())
  name          String
  niche         String
  audienceNotes String?
  voiceRules    String?
  platforms     String[]
  weights       Json?    // per-profile virality dimension weights (learned)
  exemplars     ContentExemplar[]
  ideas         ContentIdea[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContentExemplar {
  id             String       @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  platform       String
  sourceUrl      String?
  transcript     String?
  hook           String?
  isOwn          Boolean      @default(true)
  performance    Json?
  whyItWorked    String?
  createdAt      DateTime     @default(now())
}

model ContentIdea {
  id             String       @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  runId          String
  platform       String
  format         String
  title          String
  premise        String
  hooks          String[]
  angle          String
  whyItTravels   String
  viralityScore  Float
  scoreBreakdown Json
  confidence     Float
  status         String       @default("new")
  steering       Json?        // the brief's steering (goal/tone/formats/audience) — for learning what converts
  expansions     ContentExpansion[]
  outcome        ContentOutcome?
  createdAt      DateTime     @default(now())

  @@index([brandProfileId, status])
  @@index([runId])
}

model ContentExpansion {
  id        String      @id @default(cuid())
  ideaId    String
  idea      ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  version   Int         @default(1)
  createdAt DateTime    @default(now())
}

model TrendSignal {
  id           String    @id @default(cuid())
  platform     String
  kind         String
  label        String
  description  String?
  velocity     Float?
  saturation   Float?
  peakEstimate DateTime?
  sourceUrl    String?
  capturedAt   DateTime  @default(now())

  @@index([platform, capturedAt])
}

model ContentOutcome {
  id               String      @id @default(cuid())
  ideaId           String      @unique
  idea             ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  publishedAt      DateTime?
  postUrl          String?
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  followsGained    Int?
  watchThrough     Float?
  actualPercentile Float?
  hookUsed         String?     // which hook variant was actually posted (hook tournament)
  couponCode       String?     // the code tied to this post (conversion tracking)
  redemptions      Int?        // real business walked through the door from this post
  revenue          Float?      // real $ attributed to this post
  shaunNotes       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ScoreCalibration {
  id         String   @id @default(cuid())
  runId      String
  predicted  Float
  actual     Float
  dimension  String?
  recordedAt DateTime @default(now())
}

// ── Finance Operator (own bank-data engine — no Plaid) ──────────────────────

model FinanceAccount {
  id          String    @id
  businessId  String
  name        String
  institution String?
  kind        String    @default("checking")   // checking | savings | card | stripe
  currency    String    @default("USD")
  balance     Float?
  balanceAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FinanceTxn {
  id            String   @id
  accountId     String
  businessId    String
  date          DateTime @db.Date
  amount        Float                       // + income, − expense
  name          String                      // raw statement descriptor
  merchant      String                      // normalized merchant
  category      String   @default("other")
  catConfidence Float    @default(0)
  catSource     String   @default("none")   // user | rule | builtin | keyword | ai
  recurring     Boolean  @default(false)
  transfer      Boolean  @default(false)
  source        String   @default("csv")    // csv | ofx | qif | stripe
  hash          String   @unique            // stable dedupe signature
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([businessId, date(sort: Desc)])
  @@index([merchant])
}

model FinanceRule {
  id         String   @id
  businessId String
  merchant   String
  category   String
  createdAt  DateTime @default(now())

  @@unique([businessId, merchant])
}
